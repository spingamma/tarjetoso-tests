# =============================================
# 🔐 Variables de Entorno — playwright_pytest
# =============================================
# Copia este archivo como .env y llena los valores.
# NUNCA commitees el archivo .env al repositorio.

# URLs del sitio a testear (Para local usualmente es http://localhost:5173)
BASE_URL=http://localhost:5173

# API (Para local usualmente es http://localhost:8000)
API_BASE_URL=http://localhost:8000

# Base de datos de testing (Asegúrate de apuntar a la local, NO A LA DE PRODUCCIÓN)
DATABASE_URL=postgresql://test_user:test_password@localhost:5433/tarjetoso_test


# Paradigma de pruebas (internal vs external)
# internal = acceso al código fuente del backend/frontend (podemos inyectar/mockear a bajo nivel)
# external = caja negra (solo endpoints públicos o UI)
TESTING_PARADIGM=internal

# Credenciales de test (si necesitas login en sitios)
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Email testing (Gmail App Password para verificación)
EMAIL_APP_PASSWORD=

# Browser config para CI
HEADLESS=false
