# Jira Cloud: copie este archivo como .env.jira y complete los valores localmente.
# Nunca comparta ni versione JIRA_API_TOKEN.
JIRA_BASE_URL=https://empresa.atlassian.net
JIRA_EMAIL=usuario@empresa.com
JIRA_API_TOKEN=
JIRA_BOARD_ID=1

# Opcional: Columnas separadas por coma si difieren de las por defecto ("Ready for test/QA (Amb de STG)", "Ready for Test/QA (en amb Dev)")
# JIRA_COLUMNS=Ready for test/QA (Amb de STG),Ready for Test/QA (en amb Dev)

# Opcional: Zona horaria (default: America/La_Paz)
# JIRA_TIMEZONE=America/La_Paz

# Opcional: Clave del proyecto en Jira si se desea enlace directo al board
# JIRA_PROJECT_KEY=
